/**
 * COTIZADOR INTELIGENTE DE COMPRA — AUTOMOTRIZ CLASA® v6
 * Google Apps Script vinculado a Google Sheets.
 *
 * v6:
 * - Marca → Modelo → Versión ligados.
 * - Botón 1 clic mediante casilla C13 + trigger instalable.
 * - Reintentos automáticos ante 429/5xx.
 * - Modelo primario económico y fallback de mayor capacidad.
 * - Structured Outputs JSON + búsqueda web.
 * - Mensajes de error cortos y claros.
 * - Historial automático de TODAS las cotizaciones + comparables.
 */

const CLASA = {
  COTIZADOR: 'Cotizador',
  PARAMETROS: 'Parametros',
  COMPARABLES: 'Comparables IA',
  HISTORIAL: 'Historial',
  API_URL: 'https://api.openai.com/v1/responses',
  PRIMARY_MODEL: 'gpt-5.6-terra',
  FALLBACK_MODEL: 'gpt-5.6-sol',
  MAX_COMPARABLES: 8,
  BUTTON_CELL: 'C13'
};

const CLASA_LOGO_B64 = '';

function onOpen() {
  SpreadsheetApp.getUi()
    .createMenu('CLASA IA')
    .addItem('🔑 Configurar clave OpenAI', 'configurarApiKey')
    .addSeparator()
    .addItem('🚘 Cotizar vehículo con IA', 'cotizarVehiculoIA')
    .addItem('⚙️ Instalar v6 + botón 1 clic', 'instalarBoton1Clic')
    .addSeparator()
    .addItem('💾 Guardar cotización en historial', 'guardarCotizacionHistorial')
    .addItem('🧹 Limpiar resultados', 'limpiarResultados')
    .addToUi();
}

/** Simple trigger: solo mantiene dependencias. No llama servicios externos. */
function onEdit(e) {
  if (!e || !e.range) return;
  const sh = e.range.getSheet();
  if (sh.getName() !== CLASA.COTIZADOR) return;
  const a1 = e.range.getA1Notation();
  if (a1 === 'B7') {
    sh.getRange('B8:B9').clearContent();
    sh.getRange('C7:C9').clearContent();
  } else if (a1 === 'B8') {
    sh.getRange('B9').clearContent();
    sh.getRange('C8:C9').clearContent();
  } else if (a1 === 'B9') {
    sh.getRange('C9').clearContent();
  }
}

/** Trigger instalable: permite usar la casilla C13 como botón con permisos de UrlFetch. */
function onEditInstalable(e) {
  if (!e || !e.range) return;
  const sh = e.range.getSheet();
  if (sh.getName() !== CLASA.COTIZADOR) return;
  if (e.range.getA1Notation() !== CLASA.BUTTON_CELL) return;
  if (String(e.value).toUpperCase() !== 'TRUE') return;

  // Desmarcar de inmediato; los cambios por script no vuelven a disparar onEdit.
  e.range.setValue(false);
  try {
    cotizarVehiculoIAInterna_(false);
  } catch (err) {
    estadoError_(sh, mensajeAmigableError_(err));
  }
}

function instalarBoton1Clic() {
  const ss = SpreadsheetApp.getActive();
  const triggers = ScriptApp.getProjectTriggers();
  triggers.forEach(t => {
    if (t.getHandlerFunction() === 'onEditInstalable') ScriptApp.deleteTrigger(t);
  });
  ScriptApp.newTrigger('onEditInstalable').forSpreadsheet(ss).onEdit().create();

  const sh = ss.getSheetByName(CLASA.COTIZADOR);
  instalarLogo_(sh);
  sh.getRange(CLASA.BUTTON_CELL).setValue(false);
  sh.getRange('K5').setValue('BOTÓN ACTIVO');
  SpreadsheetApp.getUi().alert(
    'CLASA IA',
    'Botón 1 clic activado. Desde ahora marca la casilla junto a “COTIZAR CON IA” para ejecutar una cotización.',
    SpreadsheetApp.getUi().ButtonSet.OK
  );
}


function instalarLogo_(sh) {
  if (!sh) return;
  try {
    sh.getImages().forEach(img => {
      if ((img.getAltTextTitle() || '') === 'Logo Automotriz CLASA') img.remove();
    });
  } catch (e) {}
  const bytes = Utilities.base64Decode(CLASA_LOGO_B64);
  const blob = Utilities.newBlob(bytes, 'image/jpeg', 'logo_automotriz_clasa.jpg');
  const img = sh.insertImage(blob, 9, 1);
  img.setAltTextTitle('Logo Automotriz CLASA');
  img.setAltTextDescription('Automotriz CLASA Seminuevos');
  img.setWidth(300);
  img.setHeight(93);
  img.setAnchorCell(sh.getRange('I1'));
  img.setAnchorCellXOffset(8);
  img.setAnchorCellYOffset(4);
  sh.getRange('I1').clearContent();
}

function configurarApiKey() {
  const ui = SpreadsheetApp.getUi();
  const r = ui.prompt(
    'CLASA IA — Configurar clave OpenAI',
    'Pega tu OpenAI API key. Se guardará en Script Properties; NO se escribirá en ninguna celda.',
    ui.ButtonSet.OK_CANCEL
  );
  if (r.getSelectedButton() !== ui.Button.OK) return;
  const key = (r.getResponseText() || '').trim();
  if (!key || !key.startsWith('sk-')) {
    ui.alert('La clave no parece válida. Debe comenzar con “sk-”.');
    return;
  }
  PropertiesService.getScriptProperties().setProperty('OPENAI_API_KEY', key);
  const sh = SpreadsheetApp.getActive().getSheetByName(CLASA.COTIZADOR);
  if (sh) sh.getRange('K5').setValue('API CONFIGURADA');
  ui.alert('Clave guardada correctamente. No se guardó en ninguna celda.');
}

function cotizarVehiculoIA() {
  return cotizarVehiculoIAInterna_(true);
}

function cotizarVehiculoIAInterna_(mostrarAlertas) {
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName(CLASA.COTIZADOR);
  const params = ss.getSheetByName(CLASA.PARAMETROS);
  if (!sh || !params) throw new Error('No se encontró Cotizador o Parametros.');

  const apiKey = PropertiesService.getScriptProperties().getProperty('OPENAI_API_KEY');
  if (!apiKey) {
    const msg = 'Falta configurar la OpenAI API key en CLASA IA → Configurar clave OpenAI.';
    estadoError_(sh, msg);
    if (mostrarAlertas) SpreadsheetApp.getUi().alert(msg);
    return;
  }

  const datos = leerDatos_(sh);
  const faltantes = validarDatos_(datos);
  if (faltantes.length) {
    const msg = 'Faltan datos: ' + faltantes.join(', ');
    estadoError_(sh, msg);
    if (mostrarAlertas) SpreadsheetApp.getUi().alert(msg);
    return;
  }

  limpiarResultados_(sh, false);
  sh.getRange('K5').setValue('INVESTIGANDO…');
  sh.getRange('K6').setValue(new Date()).setNumberFormat('dd/mm/yyyy hh:mm');
  sh.getRange('K7').setValue('Buscando mercado actual');
  SpreadsheetApp.flush();

  const modeloPrimario = String(params.getRange('B10').getDisplayValue() || CLASA.PRIMARY_MODEL).trim();
  const modeloFallback = String(params.getRange('B14').getDisplayValue() || CLASA.FALLBACK_MODEL).trim();
  const intentos = Math.max(1, Number(params.getRange('B15').getValue()) || 4);
  const esperaInicial = Math.max(500, Number(params.getRange('B16').getValue()) || 2000);
  const maxComparables = Math.max(3, Number(params.getRange('B13').getValue()) || CLASA.MAX_COMPARABLES);
  const utilidadMin = Number(params.getRange('B2').getValue()) || 40000;
  const utilidadObj = Number(params.getRange('B3').getValue()) || 45000;
  const extraInicial = Number(params.getRange('B11').getValue()) || 10000;
  const redondeo = Number(params.getRange('B12').getValue()) || 1000;

  const prompt = construirPrompt_(datos, utilidadMin, utilidadObj, maxComparables);

  try {
    const response = solicitarOpenAIConRetry_(
      apiKey,
      prompt,
      modeloPrimario,
      modeloFallback,
      intentos,
      esperaInicial,
      sh
    );

    const texto = extraerTextoRespuesta_(response);
    if (!texto) throw new Error('OpenAI respondió sin contenido analizable.');

    const resultado = JSON.parse(texto);
    normalizarResultado_(resultado, maxComparables);
    aplicarGuardrails_(resultado, utilidadMin, utilidadObj, extraInicial, redondeo);

    escribirResultado_(sh, resultado);
    escribirComparables_(ss, resultado.comparables || []);

    sh.getRange('K5').setValue('LISTO');
    sh.getRange('K7').setValue((resultado.confianza || 'MEDIA').toUpperCase());
    sh.getRange('K8').setValue((resultado.comparables || []).length + ' comparables');
    SpreadsheetApp.flush();

    // Guardar automáticamente TODA cotización exitosa en Historial.
    // Si por alguna razón falla el guardado, la cotización sigue siendo válida.
    try { guardarCotizacionHistorial(false); } catch (histErr) { Logger.log(histErr); }

    if (mostrarAlertas) {
      SpreadsheetApp.getUi().alert(
        'CLASA IA — Cotización terminada',
        'Se investigó mercado actual y se llenó el cotizador. Revisa también la pestaña “Comparables IA”.',
        SpreadsheetApp.getUi().ButtonSet.OK
      );
    }
    return resultado;
  } catch (err) {
    const msg = mensajeAmigableError_(err);
    estadoError_(sh, msg);
    if (mostrarAlertas) SpreadsheetApp.getUi().alert('CLASA IA — No se pudo cotizar', msg, SpreadsheetApp.getUi().ButtonSet.OK);
    throw err;
  }
}

function solicitarOpenAIConRetry_(apiKey, prompt, modeloPrimario, modeloFallback, maxIntentos, esperaInicial, sh) {
  const modelos = [modeloPrimario, modeloFallback].filter((m, i, a) => m && a.indexOf(m) === i);
  const retryCodes = [429, 500, 502, 503, 504];
  let ultimoError = null;

  for (let m = 0; m < modelos.length; m++) {
    const modelo = modelos[m];
    for (let intento = 1; intento <= maxIntentos; intento++) {
      sh.getRange('K5').setValue(m === 0 ? 'INVESTIGANDO…' : 'FALLBACK IA…');
      sh.getRange('K7').setValue(modelo + ' • intento ' + intento + '/' + maxIntentos);
      SpreadsheetApp.flush();

      const payload = construirPayload_(modelo, prompt);
      let resp;
      try {
        resp = UrlFetchApp.fetch(CLASA.API_URL, {
          method: 'post',
          contentType: 'application/json',
          headers: { Authorization: 'Bearer ' + apiKey },
          muteHttpExceptions: true,
          payload: JSON.stringify(payload)
        });
      } catch (networkErr) {
        ultimoError = networkErr;
        if (intento < maxIntentos) {
          Utilities.sleep(Math.min(16000, esperaInicial * Math.pow(2, intento - 1)));
          continue;
        }
        break;
      }

      const code = resp.getResponseCode();
      const body = resp.getContentText();
      if (code >= 200 && code < 300) return JSON.parse(body);

      ultimoError = new Error('OpenAI API HTTP ' + code + ': ' + body);
      if (!retryCodes.includes(code)) throw ultimoError;

      if (intento < maxIntentos) {
        sh.getRange('K5').setValue('REINTENTO AUTOMÁTICO');
        SpreadsheetApp.flush();
        Utilities.sleep(Math.min(16000, esperaInicial * Math.pow(2, intento - 1)));
      }
    }
  }
  throw ultimoError || new Error('No fue posible completar la consulta a OpenAI.');
}

function construirPayload_(modelo, prompt) {
  return {
    model: modelo,
    store: false,
    reasoning: { effort: 'high' },
    max_output_tokens: 6000,
    tools: [{
      type: 'web_search_preview',
      search_context_size: 'medium',
      user_location: {
        type: 'approximate',
        country: 'MX',
        city: 'Ciudad de México',
        region: 'Ciudad de México'
      }
    }],
    include: ['web_search_call.action.sources'],
    text: {
      format: {
        type: 'json_schema',
        name: 'clasa_cotizacion',
        strict: true,
        schema: esquemaResultado_()
      }
    },
    input: prompt
  };
}

function esquemaResultado_() {
  return {
    type: 'object',
    additionalProperties: false,
    properties: {
      mercado_bajo: { type: 'number' },
      mercado_medio: { type: 'number' },
      mercado_alto: { type: 'number' },
      publicacion_sugerida: { type: 'number' },
      cierre_probable: { type: 'number' },
      propuesta_baja: { type: 'number' },
      compra_buen_estado: { type: 'number' },
      maximo_compra: { type: 'number' },
      recomendacion: { type: 'string', enum: ['COMPRAR', 'NEGOCIAR', 'NO COMPRAR', 'CONSIGNACIÓN'] },
      confianza: { type: 'string', enum: ['ALTA', 'MEDIA', 'BAJA'] },
      observaciones: { type: 'string' },
      fuentes_consultadas: { type: 'string' },
      comparables: {
        type: 'array',
        items: {
          type: 'object',
          additionalProperties: false,
          properties: {
            fuente: { type: 'string' },
            vehiculo: { type: 'string' },
            anio: { type: ['number', 'null'] },
            km: { type: ['number', 'null'] },
            precio_publicado: { type: 'number' },
            ubicacion: { type: 'string' },
            url: { type: 'string' },
            nota: { type: 'string' }
          },
          required: ['fuente', 'vehiculo', 'anio', 'km', 'precio_publicado', 'ubicacion', 'url', 'nota']
        }
      }
    },
    required: [
      'mercado_bajo','mercado_medio','mercado_alto','publicacion_sugerida','cierre_probable',
      'propuesta_baja','compra_buen_estado','maximo_compra','recomendacion','confianza',
      'observaciones','fuentes_consultadas','comparables'
    ]
  };
}

function leerDatos_(sh) {
  const b = sh.getRange('B5:B12').getDisplayValues().flat();
  const c = sh.getRange('C7:C9').getDisplayValues().flat();
  const marca = resolverManual_(b[2], c[0], 'OTRA');
  const modelo = resolverManual_(b[3], c[1], 'OTRO');
  const version = resolverManual_(b[4], c[2], 'OTRA');
  return {
    responsable: b[0],
    operacion: b[1],
    marca,
    modelo,
    version,
    anio: b[5],
    factura: b[6],
    km: b[7]
  };
}

function resolverManual_(seleccion, manual, prefijo) {
  const s = (seleccion || '').trim();
  if (s.toUpperCase().startsWith(prefijo) && (manual || '').trim()) return manual.trim();
  return s;
}

function validarDatos_(d) {
  const faltan = [];
  if (!d.responsable) faltan.push('Responsable');
  if (!d.operacion) faltan.push('Operación');
  if (!d.marca) faltan.push('Marca');
  if (!d.modelo) faltan.push('Modelo');
  if (!d.version) faltan.push('Versión');
  if (!d.anio) faltan.push('Año');
  if (!d.factura) faltan.push('Factura');
  if (!d.km) faltan.push('Kilometraje');
  return faltan;
}

function construirPrompt_(d, min, obj, maxComp) {
  return [
    'Actúa como analista senior de compras de vehículos seminuevos para Automotriz CLASA® en Ciudad de México.',
    '',
    'VEHÍCULO:',
    '- Operación: ' + d.operacion,
    '- Marca: ' + d.marca,
    '- Modelo: ' + d.modelo,
    '- Versión: ' + d.version,
    '- Año: ' + d.anio,
    '- Tipo de factura: ' + d.factura,
    '- Kilometraje: ' + d.km + ' km',
    '',
    'INVESTIGACIÓN OBLIGATORIA ANTES DE DAR PRECIOS:',
    '1) Busca mercado actual. Prioriza Libro Azul/EBC cuando sea accesible, AutoCosmos/Guía Autométrica, Mercado Libre Autos, Seminuevos.com, Kavak, agencias/lotes formales y otras fuentes confiables.',
    '2) Busca primero CDMX y Estado de México; amplía a México si faltan comparables.',
    '3) Prioriza misma marca/modelo/versión/año y kilometraje similar. No uses un solo anuncio.',
    '4) Separa precio publicado de cierre probable. El cierre debe ser conservador y comercialmente realista.',
    '5) Si una fuente no está accesible o los comparables no son exactos, no inventes datos y baja la confianza.',
    '6) Devuelve hasta ' + maxComp + ' comparables verificables con URL.',
    '',
    'REGLAS CLASA®:',
    '- Utilidad mínima obligatoria estimada: $' + formatoNumero_(min) + ' MXN.',
    '- Utilidad objetivo: $' + formatoNumero_(obj) + ' MXN o más si el mercado y la negociación lo permiten.',
    '- La propuesta baja debe buscar la mayor utilidad razonable sin convertirse en una oferta absurda.',
    '- Compra en buen estado debe proteger aproximadamente la utilidad objetivo.',
    '- Máximo sugerido debe proteger al menos la utilidad mínima contra el cierre probable.',
    '- Todavía NO ajustes por adeudos, estética, mecánica, llantas, testigos ni documentos. Eso se revisa físicamente en CLASA®.',
    '- La IA recomienda; la compra final requiere autorización humana.',
    '- Si es SOLO VENTA y es 2011 o anterior, recomienda CONSIGNACIÓN. Si el máximo de compra estimado queda en $290,000 o más, recomienda CONSIGNACIÓN.',
    '',
    'Calcula mercado bajo/medio/alto, publicación, cierre probable y las tres propuestas de compra. No infles cierre para hacer cuadrar la utilidad.'
  ].join('\n');
}

function extraerTextoRespuesta_(obj) {
  if (typeof obj.output_text === 'string' && obj.output_text.trim()) return obj.output_text.trim();
  const output = obj.output || [];
  for (let i = 0; i < output.length; i++) {
    const content = output[i].content || [];
    for (let j = 0; j < content.length; j++) {
      if ((content[j].type === 'output_text' || content[j].type === 'text') && content[j].text) {
        return String(content[j].text).trim();
      }
    }
  }
  return '';
}

function normalizarResultado_(r, maxComp) {
  const nums = ['mercado_bajo','mercado_medio','mercado_alto','publicacion_sugerida','cierre_probable','propuesta_baja','compra_buen_estado','maximo_compra'];
  nums.forEach(k => r[k] = numero_(r[k]));
  if (!Array.isArray(r.comparables)) r.comparables = [];
  r.comparables = r.comparables.slice(0, maxComp);
  r.recomendacion = (r.recomendacion || 'NEGOCIAR').toUpperCase();
  r.confianza = (r.confianza || 'MEDIA').toUpperCase();
}

function aplicarGuardrails_(r, min, obj, extra, redondeo) {
  const cierre = numero_(r.cierre_probable);
  if (!cierre) throw new Error('La IA no devolvió un precio probable de cierre válido.');

  const maxPermitido = redondearAbajo_(cierre - min, redondeo);
  const compraObjetivo = redondearAbajo_(cierre - obj, redondeo);
  const compraInicial = redondearAbajo_(cierre - obj - extra, redondeo);

  r.maximo_compra = limitarCompra_(r.maximo_compra, maxPermitido, redondeo);
  r.compra_buen_estado = limitarCompra_(r.compra_buen_estado, compraObjetivo, redondeo);
  r.propuesta_baja = limitarCompra_(r.propuesta_baja, compraInicial, redondeo);

  if (r.compra_buen_estado > r.maximo_compra) r.compra_buen_estado = r.maximo_compra;
  if (r.propuesta_baja > r.compra_buen_estado) r.propuesta_baja = r.compra_buen_estado;

  r.utilidad_baja = cierre - r.propuesta_baja;
  r.utilidad_buen_estado = cierre - r.compra_buen_estado;
  r.utilidad_maximo = cierre - r.maximo_compra;
}

function limitarCompra_(valorIA, tope, redondeo) {
  let v = numero_(valorIA);
  if (!v || v < 0) v = tope;
  return redondearAbajo_(Math.min(v, tope), redondeo);
}

function escribirResultado_(sh, r) {
  sh.getRange('E5:E14').setValues([
    [r.mercado_bajo],
    [r.mercado_medio],
    [r.mercado_alto],
    [r.propuesta_baja],
    [r.compra_buen_estado],
    [r.maximo_compra],
    [r.publicacion_sugerida],
    [r.cierre_probable],
    [r.recomendacion],
    [r.observaciones]
  ]);
  sh.getRange('E5:E12').setNumberFormat('$#,##0');
  sh.getRange('E14').setWrap(true);
}

function escribirComparables_(ss, comps) {
  let sh = ss.getSheetByName(CLASA.COMPARABLES);
  if (!sh) sh = ss.insertSheet(CLASA.COMPARABLES);
  sh.getRange('A4:H120').clearContent();
  if (!comps.length) return;
  const rows = comps.map(c => [
    c.fuente || '', c.vehiculo || '', c.anio || '', c.km || '',
    numero_(c.precio_publicado), c.ubicacion || '', c.url || '', c.nota || ''
  ]);
  sh.getRange(4, 1, rows.length, 8).setValues(rows);
  sh.getRange(4, 4, rows.length, 1).setNumberFormat('#,##0');
  sh.getRange(4, 5, rows.length, 1).setNumberFormat('$#,##0');
  sh.getRange(4, 1, rows.length, 8).setWrap(true);
}

function guardarCotizacionHistorial(mostrarAlerta) {
  const ss = SpreadsheetApp.getActive();
  const sh = ss.getSheetByName(CLASA.COTIZADOR);
  const hist = ss.getSheetByName(CLASA.HISTORIAL);
  const comp = ss.getSheetByName(CLASA.COMPARABLES);
  if (typeof mostrarAlerta === 'undefined') mostrarAlerta = true;
  if (!sh || !hist) throw new Error('Falta Cotizador o Historial.');
  if (!sh.getRange('E12').getValue()) {
    if (mostrarAlerta) SpreadsheetApp.getUi().alert('Primero realiza una cotización con IA.');
    return;
  }

  // K6 funciona como ID de la cotización. Evita duplicados si se pulsa Guardar manualmente.
  const idCotizacion = sh.getRange('K6').getValue();
  const lastRow = hist.getLastRow();
  if (idCotizacion && lastRow >= 2) {
    const ids = hist.getRange(2, 25, lastRow - 1, 1).getValues().flat();
    const clave = idCotizacion instanceof Date ? idCotizacion.getTime() : String(idCotizacion);
    const existe = ids.some(v => (v instanceof Date ? v.getTime() : String(v)) === clave);
    if (existe) {
      if (mostrarAlerta) SpreadsheetApp.getUi().alert('Esta cotización ya está guardada en Historial.');
      return;
    }
  }

  const d = leerDatos_(sh);
  let fuentes = '';
  if (comp) {
    const vals = comp.getRange('A4:A20').getDisplayValues().flat().filter(Boolean);
    fuentes = [...new Set(vals)].join(', ');
  }

  const row = [
    new Date(), d.responsable, d.operacion, d.marca, d.modelo, d.version,
    d.anio, d.factura, numero_(d.km),
    sh.getRange('E8').getValue(), sh.getRange('E9').getValue(), sh.getRange('E10').getValue(),
    sh.getRange('E11').getValue(), sh.getRange('E12').getValue(), sh.getRange('E13').getDisplayValue(),
    '', '', '', '', sh.getRange('E14').getDisplayValue(), fuentes,
    sh.getRange('E5').getValue(), sh.getRange('E6').getValue(), sh.getRange('E7').getValue(),
    idCotizacion
  ];
  hist.appendRow(row);
  const lr = hist.getLastRow();
  hist.getRange(lr, 1).setNumberFormat('dd/mm/yyyy hh:mm');
  hist.getRange(lr, 9).setNumberFormat('#,##0');
  hist.getRange(lr, 10, 1, 8).setNumberFormat('$#,##0');
  hist.getRange(lr, 22, 1, 3).setNumberFormat('$#,##0');
  hist.getRange(lr, 25).setNumberFormat('dd/mm/yyyy hh:mm:ss');
  if (mostrarAlerta) SpreadsheetApp.getUi().alert('Cotización guardada en Historial.');
}

function limpiarResultados() {
  const sh = SpreadsheetApp.getActive().getSheetByName(CLASA.COTIZADOR);
  limpiarResultados_(sh, true);
}

function limpiarResultados_(sh, limpiarEstatus) {
  sh.getRange('E5:E14').clearContent();
  if (limpiarEstatus) {
    sh.getRange('K5:K8').clearContent();
    sh.getRange('K5').setValue('LISTO PARA COTIZAR');
  }
}

function estadoError_(sh, mensaje) {
  sh.getRange('K5').setValue('ERROR');
  sh.getRange('K6').setValue(new Date()).setNumberFormat('dd/mm/yyyy hh:mm');
  sh.getRange('K7').setValue(mensaje).setWrap(true);
}

function mensajeAmigableError_(err) {
  const s = String(err && err.message ? err.message : err || 'Error desconocido');
  if (s.includes('HTTP 503') || s.includes('server_is_overloaded')) return 'OpenAI está saturado temporalmente. v6 reintentó automáticamente; vuelve a cotizar en unos minutos.';
  if (s.includes('HTTP 429')) return 'Límite temporal de API alcanzado. Espera un momento y vuelve a cotizar.';
  if (s.includes('HTTP 401')) return 'La API key no fue aceptada. Revisa CLASA IA → Configurar clave OpenAI.';
  if (s.includes('HTTP 402')) return 'Revisa el saldo/facturación de OpenAI API.';
  if (s.includes('HTTP 400')) return 'La API rechazó la solicitud. Revisa que el script v6 esté completo y actualizado.';
  if (s.length > 280) return s.slice(0, 277) + '…';
  return s;
}

function numero_(v) {
  if (typeof v === 'number') return v;
  const n = parseFloat(String(v == null ? '' : v).replace(/[^0-9.-]/g, ''));
  return isNaN(n) ? 0 : n;
}

function redondearAbajo_(v, paso) {
  paso = paso || 1000;
  return Math.floor(v / paso) * paso;
}

function formatoNumero_(n) {
  return Math.round(numero_(n)).toLocaleString('es-MX');
}
